// The private test site: a Cloudflare Worker serving the build's files (static assets, no code) at test.neuralsummit.io,
// where Cloudflare Access already asks for an emailed one-time code. No public Cloudflare address at all: workers.dev
// and preview URLs are off, so the only way in is through Access. Deployed by the pipeline's test step (.github/workflows/site.yml).
{
	"name": "neuralsummit-test",
	"compatibility_date": "2026-10-06",
	// the files go through test-worker.js first, which answers range requests (jumping into a listen's audio)
	"main": "test-worker.js",
	"assets": { "directory": "./test-deploy", "binding": "ASSETS", "run_worker_first": true },
	"workers_dev": false,
	"preview_urls": false,
	"routes": [{ "pattern": "test.neuralsummit.io", "custom_domain": true }]
}
